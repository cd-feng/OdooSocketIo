<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_res_config_settings_form_inherit" model="ir.ui.view">
        <field name="name">Odoo SocketIo Config Settings</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="10"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="SocketIo" string="SocketIo" name="odoo_socketio">
                    <h2>SocketIo Config Settings</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <div class="content-group">
                                    <label for="socketio_server_host" class="o_form_label"/>
                                    <div class="text-muted">
                                        The host address where the SocketIo server runs.
                                    </div>
                                    <div class="mt16">
                                        <field name="socketio_server_host" style="width:100%;"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <div class="content-group">
                                    <label for="socketio_server_port" class="o_form_label"/>
                                    <div class="text-muted">
                                        The port where the SocketIo server runs.
                                    </div>
                                    <div class="mt16">
                                        <field name="socketio_server_port" style="width:100%;"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <div class="content-group">
                                    <label for="socketio_handshake_path" class="o_form_label"/>
                                    <div class="text-muted">
                                        Default: /socket.io
                                    </div>
                                    <div class="mt16">
                                        <field name="socketio_handshake_path" style="width:100%;"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <div class="content-group">
                                    <label for="socketio_odoo_connection_type" class="o_form_label"/>
                                    <div class="text-muted">
                                        For environments without domain names or local development, you can directly use the IP+Port method to connect. In a production environment, you can use nginx to proxy the socketio handshake path.
                                    </div>
                                    <div class="mt16">
                                        <field name="socketio_odoo_connection_type" style="width:100%;" required="1"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_odoo_socketio_config_settings" model="ir.actions.act_window">
        <field name="name">Odoo SocketIo Config Settings Action</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_id" ref="view_res_config_settings_form_inherit"/>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'odoo_socketio'}</field>
    </record>

</odoo>